# Скопируйте в .env и заполните. Файл .env не коммитится.

# Публичные — попадают в браузер через dist/config.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Секретные — только для Edge Functions (supabase secrets set), в браузер не попадают
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Адрес сайта для поисковиков (канонические ссылки, sitemap.xml). Пример: https://inzh-klub.ru
SITE_URL=
